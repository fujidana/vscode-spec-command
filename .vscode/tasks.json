{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "compile",
			"detail": "Run peggy, eslint, tsc (noEmit), and esbuild",
			"icon": {
				"id": "build"
			},
			"type": "npm",
			"script": "compile",
			"group": "build",
			"problemMatcher": [
				"$peggy",
				"$eslint-stylish",
				"$tsc",
				"$esbuild"
			]
		},
		{
			"label": "watch",
			"detail": "Watch peggy, tsc (noEmit), and esbuild",
			"icon": {
				"id": "build"
			},
			"dependsOn": [
				"npm: watch:peggy",
				"npm: watch:tsc",
				"npm: watch:esbuild"
			],
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "npm: watch:peggy",
			"icon": {
				"id": "build"
			},
			"type": "npm",
			"script": "watch:peggy",
			"group": "build",
			"problemMatcher": "$peggy-watch",
			"isBackground": true,
			"presentation": {
				"group": "watchers",
				"reveal": "never"
			}
		},
		{
			"label": "npm: watch:esbuild",
			"icon": {
				"id": "build"
			},
			"type": "npm",
			"script": "watch:esbuild",
			"group": "build",
			"problemMatcher": "$esbuild-watch",
			"isBackground": true,
			"presentation": {
				"group": "watchers",
				"reveal": "never"
			}
		},
		{
			"label": "npm: watch:tsc",
			"icon": {
				"id": "build"
			},
			"type": "npm",
			"script": "watch:tsc",
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"group": "watchers",
				"reveal": "never"
			}
		},
		{
			"label": "npm: watch-tests",
			"icon": {
				"id": "build"
			},
			"type": "npm",
			"script": "watch-tests",
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"group": "watchers",
				"reveal": "never"
			}
		},
		{
			"label": "test",
			"detail": "watch peggy, tsc (noEmit), and esbuild, then run vscode-test",
			"icon": {
				"id": "beaker"
			},
			"type": "npm",
			"script": "test",
			"dependsOn": [
				"npm: watch:peggy",
				"npm: watch-tests",
				"npm: watch:esbuild"
			],
			"dependsOrder": "sequence",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "test-web",
			"detail": "Watch peggy, tsc (noEmit), and esbuild, then run vscode-test-web",
			"icon": {
				"id": "beaker"
			},
			"type": "npm",
			"script": "test-web",
			"dependsOn": [
				"npm: watch:peggy",
				"npm: watch:tsc",
				"npm: watch:esbuild"
			],
			"group": "test",
			"problemMatcher": []
		}
	]
}